msgctxt "Context menu item to show"
msgid "Copy"
msgstr "Копировать"

#: package/contents/config/ConfigContextMenu.qml
msgid "The PID, app ID or .desktop file path, for a bug report."
msgstr "PID, ID приложения или путь к файлу .desktop, для сообщения об ошибке."

