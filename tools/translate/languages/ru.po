# --- ContextMenu.qml ---
#: package/contents/config/ConfigContextMenu.qml package/contents/ui/ContextMenu.qml
msgid "Places"
msgstr "Точки входа"

#: package/contents/config/ConfigContextMenu.qml
msgid "A Places submenu with the places from Dolphin's Places panel: Home, Downloads, Trash, added folders. Only in Dolphin's menu."
msgstr "Подменю «Точки входа» с пунктами из панели «Точки входа» Dolphin: домашняя папка, загрузки, корзина, добавленные папки. Только в меню Dolphin."

#: package/contents/config/ConfigContextMenu.qml
msgid "Recent files and folders"
msgstr "Недавние файлы и папки"

#: package/contents/config/ConfigContextMenu.qml
msgid "Recent Documents and Recent Folders: what was opened with the app in the current activity, as Plasma records it. Forget Recent Files clears the list."
msgstr "«Недавние документы» и «Недавние папки»: что открывалось в приложении в текущей комнате, по данным Plasma. «Очистить недавние» очищает список."

#: package/contents/config/ConfigContextMenu.qml
msgid "Browsing history"
msgstr "История браузера"

#: package/contents/config/ConfigContextMenu.qml
msgid "Recent Pages: the latest pages from the browser's history, with their icons. Firefox, Chrome, Chromium, Brave, Vivaldi, Edge and Opera, including Flatpak and Snap versions."
msgstr "«Недавние страницы»: последние страницы из истории браузера, со значками. Firefox, Chrome, Chromium, Brave, Vivaldi, Edge и Opera, включая версии Flatpak и Snap."

#: package/contents/config/ConfigContextMenu.qml
msgid "Number of browser history items:"
msgstr "Количество элементов истории:"

#: package/contents/config/ConfigContextMenu.qml
msgid "Media controls"
msgstr "Элементы управления медиа"

#: package/contents/config/ConfigContextMenu.qml
msgid "Previous Track, Play/Pause, Next Track and Stop, for media players (MPRIS). Quit and Restore of such players stay in the menu."
msgstr "«Предыдущий трек», «Воспроизвести»/«Пауза», «Следующий трек» и «Стоп» у медиаплееров (MPRIS). «Выйти» и «Восстановить» у таких плееров остаются в меню."

#: package/contents/config/ConfigContextMenu.qml
msgctxt "Context menu item to show"
msgid "Mute"
msgstr "Выключение звука"

#: package/contents/config/ConfigContextMenu.qml
msgid "Mute/Unmute all the app's sound. For apps with an audio stream open, even a silent one."
msgstr "«Выключить звук»/«Включить звук» для всего звука приложения. У приложений с открытым аудиопотоком, даже беззвучным."

#: package/contents/config/ConfigContextMenu.qml
msgid "Hide 'Move to Desktop' if only one virtual desktop is used"
msgstr "Скрывать «Переместить на рабочий стол», если рабочий стол один"

#: package/contents/config/ConfigContextMenu.qml
msgid "Extra items with Shift"
msgstr "Дополнительные пункты с Shift"

#: package/contents/config/ConfigContextMenu.qml
msgid "Items for a task's menu, and a window's menu in its tooltip, opened with Shift held."
msgstr "Пункты меню задачи и меню окна в подсказке, открытых с зажатым Shift."

#: package/contents/config/ConfigContextMenu.qml package/contents/ui/ContextMenu.qml
msgid "Force Quit"
msgstr "Завершить принудительно"

#: package/contents/config/ConfigContextMenu.qml
msgid "Kills the app's process, for an app that no longer responds to Close."
msgstr "Убивает процесс приложения, которое больше не отвечает на «Закрыть»."

